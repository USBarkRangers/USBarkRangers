// Shared by app and test targets; BarkDomain declares Swift 6 in Package.swift.
IPHONEOS_DEPLOYMENT_TARGET = 18.4
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
BARK_DEVELOPMENT_TEAM = V7Y6NA8G23
// Optional developer-owned overrides; never checked in.
#include? "Signing.local.xcconfig"

// Set only after native catalog assets have been provisioned and verified.
BARK_CATALOG_MANIFEST_URL =
#include? "Catalog.local.xcconfig"

// Native provider callback is developer-owned until Firebase iOS registration is supplied.
BARK_GOOGLE_REVERSED_CLIENT_ID = barkranger-google-unconfigured
#include? "Accounts.local.xcconfig"

// Apply to our targets only; third-party packages may intentionally suppress their own warnings.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
